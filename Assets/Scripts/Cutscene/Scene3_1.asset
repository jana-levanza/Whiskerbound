  typingSpeed: 0.05
  autoProgressDelay: 1.5
  autoProgressLines: 010101010101010101010100
  dialogueLines:
  - "Yoichi: Parang may bumagsak dito\u2026 at\u2014"
  - "Shuyi: \u2026Yoichi."
  - 'Yoichi: Ano?'
  - "Shuyi: \u2026Paw prints."
  - "Shuyi: Sigurado ako\u2026 sa kanya \u2018to\u2026"
  - "Yoichi: Neela\u2026 nandito siya\u2026 nandito siya!"
  - "Shuyi: \u2026Pero wala siya dito ngayon\u2026"
  - "Yoichi: \u2026Oo."
  - "Shuyi: Yoichi\u2026 kung nandito siya\u2026 may nagdala sa kanya."
  - "Yoichi: \u2026Yung karwahe."
  - "Shuyi: Kung sino man \u2018yon\u2026 sila ang susundan natin."
  - "Yoichi: \u2026At kukunin natin si Neela.\u201D"
