  m_Script: {fileID: 11500000, guid: cdab385c067d82a4f9735a1ac1ed59fe, type: 3}
  m_Name: Wiggi_BeforeQuest
  m_EditorClassIdentifier: Assembly-CSharp::GameDialogueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  autoProgressLines: 0101010101010101010101010100
  dialogueLines:
  - 'Wiggi: Kayo yung galing kay Lalei.'
  - 'Yoichi: Oo. Mukhang ikaw na yung susunod sa listahan namin.'
  - "Wiggi: Kung papasok kayo sa maze\u2026 huwag niyong maliitin."
  - 'Shuyi: Anong dapat naming malaman?'
  - 'Wiggi: Hindi lang kalaban ang haharapin niyo.'
  - "Wiggi: May maririnig kayo. Hindi niyo agad makikita\u2026 pero ramdam niyo na
    may mali. "
  - "Yoichi: \u2026Hindi reassuring. "
  - 'Wiggi: Mas lalo kapag nasa loob na kayo. Parang may sumusunod. Parang may gustong
    lumapit.'
  - "Wiggi: Kapag may narinig kayo sa likod\u2026 huwag kayong lilingon. "
  - "Yoichi: Hindi ko \u2018yan kaya"
  - 'Wiggi: Subukan niyo. Kasi may mga bagay na mas mabuti nang hindi niyo makita.'
  - 'Shuyi: Gets namin.'
  - "Wiggi: Kung gusto niyong marinig galing sa nakaabot na\u2026 kausapin niyo si
    Jinbe. Siya lang yung nakarating sa gitna at bumalik."
  - "Yoichi: \u2026Hindi pa reassuring, pero sige, slamat Wiggi."
