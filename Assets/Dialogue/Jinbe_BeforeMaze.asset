  m_Script: {fileID: 11500000, guid: cdab385c067d82a4f9735a1ac1ed59fe, type: 3}
  m_Name: Jinbe_BeforeMaze
  m_EditorClassIdentifier: Assembly-CSharp::GameDialogueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  autoProgressLines: 01010101010101010101010101010101010100
  dialogueLines:
  - "Jinbe: Kayo na yung susunod, \u2018no?"
  - 'Yoichi: Mukhang ganon na nga.'
  - 'Jinbe: Nakarating ako sa gitna.'
  - 'Shuyi: Nakita mo yung chest?'
  - "Jinbe: \u2026Oo."
  - 'Jinbe: Tahimik doon. Sobrang tahimik na parang may mali.'
  - "Jinbe: Habang papalapit ako\u2026 parang may kasabay ako."
  - "Jinbe: Habang papalapit ako\u2026 parang may kasabay ako."
  - "Yoichi: \u2026Kasabay?"
  - 'Jinbe: Hindi ko siya nakita. Ayoko siyang makita.'
  - "Jinbe: Pero ramdam ko\u2026 nakatingin siya."
  - 'Shuyi: Hindi ka lumingon.'
  - 'Jinbe: Hindi.'
  - 'Jinbe: Pero ang alam ko nandun yung chest. Totoo siya.'
  - "Jinbe: Hindi lang siya kwento. Naniniwala ako\u2026"
  - "Jinbe: Kung may hinahanap kayong sagot\u2026 wala kayong ibang mapupuntahan."
  - "Jinbe: Try niyo\u2026 baka may makuha kayong sagot sa mga katanungan niyo."
  - "Yoichi: \u2026Ang bigat naman ng \u2018try niyo."
  - 'Shuyi: Sige. Susubukan namin.'
