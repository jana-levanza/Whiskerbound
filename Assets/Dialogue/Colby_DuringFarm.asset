  m_Script: {fileID: 11500000, guid: cdab385c067d82a4f9735a1ac1ed59fe, type: 3}
  m_Name: Colby_DuringFarm
  m_EditorClassIdentifier: Assembly-CSharp::GameDialogueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  autoProgressLines: 010101010101010100
  dialogueLines:
  - 'Colby:  Nakita niyo na ba kung ano ang sumisira sa farm? '
  - 'Shuyi:  Oo. Nasa taniman nga sila. '
  - "Colby:  Mag-ingat kayo\u2026 hindi sila normal gumalaw. Bigla na lang silang
    sumusulpot. "
  - "Yoichi:  Mukha nga. At halatang hindi na basta-bastang peste lang \u2018to. "
  - "Colby:  Noong una, akala ko may makakaya pa kaming iligtas. Pero habang tumatagal,
    mas dumarami ang sira\u2026 at mas kumakapal \u2018yung pakiramdam na may mali
    sa lugar. "
  - "Shuyi:  Kapag natapos namin \u2018to, sasabihin mo ang alam mo. Tama? "
  - 'Colby:  Tama. Kapag naalis niyo sila, wala na akong itatago sa inyo. '
  - 'Shuyi:  Buti naman. Kasi hindi rin kami nandito para mag-aksaya ng oras. '
  - "Colby:  Naiintindihan ko. Kaya pakiusap\u2026 tuluyan niyo nang tapusin ang
    nasa taniman. "
