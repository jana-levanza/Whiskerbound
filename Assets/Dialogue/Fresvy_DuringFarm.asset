  m_Script: {fileID: 11500000, guid: cdab385c067d82a4f9735a1ac1ed59fe, type: 3}
  m_Name: Fresvy_DuringFarm
  m_EditorClassIdentifier: Assembly-CSharp::GameDialogueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  autoProgressLines: 01010101010100
  dialogueLines:
  - 'Fresvy: Talaga bang pupunta kayo sa farm?'
  - "Shuyi: Wala kaming choice. Kailangan naming ayusin \u2018yon para makuha ang
    impormasyon na kailangan namin."
  - "Fresvy: Mag-iingat kayo\u2026 kanina pa parang may kumakaluskos na naman sa
    may taniman."
  - 'Yoichi: Akala ko ba tahimik na sa umaga?'
  - 'Fresvy: Akala rin namin noon. Pero nitong mga nakaraan, parang kahit anong oras
    puwede silang gumalaw.'
  - 'Shuyi: Mas lalo lang palang lumalala.'
  - 'Fresvy: Oo. Kaya nag-aalala kaming baka hindi lang pananim ang target nila sa
    susunod.'
