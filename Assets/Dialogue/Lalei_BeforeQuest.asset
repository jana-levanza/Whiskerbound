  m_Script: {fileID: 11500000, guid: cdab385c067d82a4f9735a1ac1ed59fe, type: 3}
  m_Name: Lalei_BeforeQuest
  m_EditorClassIdentifier: Assembly-CSharp::GameDialogueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  autoProgressLines: 0101010101010101010101010100
  dialogueLines:
  - 'Lalei: Narinig ko nagtatanong kayo tungkol sa maze.'
  - "Yoichi: Hindi naman namin hinahanap\u2026 pero mukhang doon kami papunta."
  - "Lalei: Kung ganon, makinig kayo. May maze sa dulo ng slums. Luma na \u2018yon,
    pero may pumapasok pa rin. "
  - "Lalei: Hindi dahil ligtas\u2026 kundi dahil may hinahanap sila. "
  - 'Shuyi: Anong meron sa loob? '
  - 'Lalei: Sa gitna, may chest. '
  - 'Lalei: Yun yung dahilan kung bakit may bumabalik pa rin kahit alam nilang delikado. '
  - 'Yoichi: May nakakuha na ba?'
  - "Lalei: May nakakaalam, oo. Pero walang nakauwi na dala \u2018yon."
  - "Lalei: Kung may hinahanap kayong sagot\u2026 baka nandun."
  - "Yoichi: \u2026\u2018baka\u2019 ulit."
  - 'Lalei: Ganun dito.'
  - "Lalei: Kung gusto niyong mas maintindihan\u2026 kausapin niyo si Wiggi. Madalas
    siya magbantay malapit sa entrance."
  - 'Shuyi: Sige, maraming salamat Lalei.'
