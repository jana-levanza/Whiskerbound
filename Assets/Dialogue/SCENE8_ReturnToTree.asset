  m_Name: SCENE8_ReturnToTree
  m_EditorClassIdentifier: Assembly-CSharp::GameDialogueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  autoProgressLines: 
  dialogueLines:
  - "Yoichi: \u2026Nandito ulit tayo."
  - "Shuyi: Hindi pa rin natin kayang galawin \u2018to\u2026"
  - "Yoichi: \u2026Kung dati siguro\u2026 susubukan ko na lang paulit-ulit."
  - 'Shuyi: Pero ngayon?'
  - "Yoichi: \u2026Makikinig muna ako."
  - "Shuyi: \u2026Pwede nating hatiin. Ikaw sa baba, ako sa gilid\u2014"
  - 'Yoichi: Mas stable kung sabay natin susubukan.'
  - "Shuyi: \u2026Oo."
  - 'Shuyi: Whoooooh.'
  - "Yoichi: \u2026Ano \u2018yon?!"
  - "Shuyi: \u2026Yoichi\u2014"
  - "Yoichi: \u2026Sandata?"
  - "Shuyi: \u2026Imposible\u2026"
  - "Yoichi: \u2026Pero\u2026 pwede na \u2018to."
  - "Yoichi: \u2026Pero\u2026 pwede na \u2018to."
  - "Yoichi: \u2026Mabagal."
  - 'Shuyi: Hindi sapat.'
  - "Yoichi: \u2026Nagbago ulit?!"
  - "Shuyi: \u2026Hayaan mo ako."
  - "Yoichi: \u2026Apoy\u2026?"
  - "Yoichi: \u2026So puwede natin palitan\u2026"
  - "Shuyi: \u2026Depende sa kailangan."
  - 'Yoichi: Kung sabay natin gamitin'
  - "Shuyi: \u2026Mas mabilis."
